# ============================================================
# AutoCV Robot — AI Configuration (TEMPLATE)
# Copy this file to ".env" and fill in real values locally.
# NEVER commit the real ".env" file.
# ============================================================

# Primary provider: Gemini | OpenAI (OpenAI-compatible endpoint, e.g. OpenRouter)
AI_PROVIDER=Gemini
AI_FALLBACK_PROVIDER=OpenAI

# ---- OpenRouter / OpenAI-compatible endpoint (fallback) ----
OPENAI_API_KEY=<openrouter-api-key>
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=openai/gpt-4o-mini

# ---- Google Gemini (primary) ----
GEMINI_API_KEY=<gemini-api-key>
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
