        </If.Then>
        <If.Else>
          <Sequence DisplayName="Call Gemini API" sap2010:WorkflowViewState.IdRef="Sequence_4">
            <TryCatch sap2010:Annotation.AnnotationText="[PENANGANAN ERROR] Mencoba request ke Google Gemini API dengan retry 3 kali. Jika terkena limit (429), server error (500), atau jaringan putus, blok Catch menangkap exception dan mengarahkan ke fallback mock tanpa menghentikan alur." DisplayName="Try Gemini synthesis" sap2010:WorkflowViewState.IdRef="TryCatch_1">
              <sap:WorkflowViewStateService.ViewState>
                <scg:Dictionary x:TypeArguments="x:String, x:Object">
                  <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                  <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                </scg:Dictionary>
              </sap:WorkflowViewStateService.ViewState>
              <TryCatch.Try>
                <Sequence DisplayName="Call and parse Gemini" sap2010:WorkflowViewState.IdRef="Sequence_5">
                  <ui:InvokeCode DisplayName="Call Gemini API directly with API key" Language="VBNet" Code="statusCode = 0&#xA;rawText = &quot;&quot;&#xA;resumeJson = &quot;&quot;&#xA;errorDetail = &quot;&quot;&#xA;Dim attempt As Integer = 0&#xA;Dim lastError As String = &quot;&quot;&#xA;Try&#xA;  While attempt &lt; 3&#xA;    attempt += 1&#xA;    Try&#xA;      Dim handler As New System.Net.Http.HttpClientHandler()&#xA;      handler.UseProxy = True&#xA;      Using client As New System.Net.Http.HttpClient(handler)&#xA;        client.Timeout = System.TimeSpan.FromSeconds(90)&#xA;        Dim content As New System.Net.Http.StringContent(requestBody, System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;        Dim response As System.Net.Http.HttpResponseMessage = client.PostAsync(apiUrl, content).GetAwaiter().GetResult()&#xA;        statusCode = CInt(response.StatusCode)&#xA;        rawText = response.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;      End Using&#xA;      If statusCode &gt;= 500 AndAlso attempt &lt; 3 Then&#xA;        lastError = &quot;Gemini HTTP status &quot; &amp; statusCode.ToString()&#xA;        System.Threading.Thread.Sleep(2000)&#xA;      Else&#xA;        Exit While&#xA;      End If&#xA;    Catch ex As Exception&#xA;      lastError = &quot;Gemini call failed: &quot; &amp; ex.Message&#xA;      If attempt &lt; 3 Then&#xA;        System.Threading.Thread.Sleep(2000)&#xA;      End If&#xA;    End Try&#xA;  End While&#xA;  If statusCode = 200 Then&#xA;    Dim envelope As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(rawText)&#xA;    Dim token As Newtonsoft.Json.Linq.JToken = envelope.SelectToken(&quot;candidates[0].content.parts[0].text&quot;)&#xA;    If token Is Nothing Then&#xA;      errorDetail = &quot;Gemini response did not contain candidate text&quot;&#xA;    Else&#xA;      rawText = token.ToString()&#xA;      resumeJson = rawText.Replace(&quot;```json&quot;, String.Empty).Replace(&quot;```&quot;, String.Empty).Trim()&#xA;      Dim check As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(resumeJson)&#xA;    End If&#xA;  Else&#xA;    errorDetail = If(String.IsNullOrEmpty(lastError), &quot;Gemini HTTP status &quot; &amp; statusCode.ToString() &amp; &quot;: &quot; &amp; rawText, lastError)&#xA;  End If&#xA;Catch ex As Exception&#xA;  errorDetail = &quot;Gemini call failed: &quot; &amp; ex.Message&#xA;End Try" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
                    <ui:InvokeCode.Arguments>
                      <InArgument x:TypeArguments="x:String" x:Key="apiUrl">[strApiUrl]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="requestBody">[strRequestBody]</InArgument>
                      <OutArgument x:TypeArguments="x:Int32" x:Key="statusCode">[intHttpStatus]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="rawText">[strRawAIResponse]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="resumeJson">[strExtractedJson]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="errorDetail">[strErrorDetail]</OutArgument>
                    </ui:InvokeCode.Arguments>
                  </ui:InvokeCode>
                  <If Condition="[intHttpStatus = 200 AndAlso Not String.IsNullOrWhiteSpace(strExtractedJson)]" sap2010:Annotation.AnnotationText="[PERCABANGAN LOGIKA] Mengecek apakah HTTP status bernilai 200 OK dan JSON hasil sintesis berhasil di-parse. Jika sukses, tandai boolAiSuccess=True." DisplayName="Use Gemini result when synthesis succeeded" sap2010:WorkflowViewState.IdRef="If_3">
                    <sap:WorkflowViewStateService.ViewState>
                      <scg:Dictionary x:TypeArguments="x:String, x:Object">
                        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
                        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                      </scg:Dictionary>
                    </sap:WorkflowViewStateService.ViewState>
                    <If.Then>
