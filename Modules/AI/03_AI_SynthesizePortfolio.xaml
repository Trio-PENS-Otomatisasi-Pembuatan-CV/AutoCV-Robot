            </Assign.Value>
          </Assign>
        </If.Then>
      </If>

      <!-- 3. Build system prompt for ATS resume synthesis -->
      <Assign DisplayName="Build Gemini system prompt" sap2010:WorkflowViewState.IdRef="Assign_7">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[strSystemPrompt]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">["You are an expert ATS resume writer and career consultant." &amp; System.Environment.NewLine &amp; "Analyze the LinkedIn and GitHub data provided by the user and return ONE JSON object." &amp; System.Environment.NewLine &amp; "Return ONLY raw JSON with no markdown code fences and no commentary before or after it." &amp; System.Environment.NewLine &amp; "Write every section in English." &amp; System.Environment.NewLine &amp; "Format each experience bullet point using the STAR/XYZ pattern: state the action, the measurable result, and how the result was achieved." &amp; System.Environment.NewLine &amp; "Quantify achievements with concrete numbers wherever the source data supports them." &amp; System.Environment.NewLine &amp; "Include all supplied non-fork GitHub repositories (up to 10) in the projects array. Set isSelected to true for the 3 or 4 repositories that best match the target job role, and set isSelected to false for the remaining repositories so the candidate can curate them." &amp; System.Environment.NewLine &amp; "The JSON must contain exactly these top-level keys." &amp; System.Environment.NewLine &amp; "profile is an object with fullName, headline, email, phone, location, summary, linkedinUrl, githubUrl." &amp; System.Environment.NewLine &amp; "experiences is an array of objects with id, company, role, startDate, endDate, bulletPoints which is an array of strings." &amp; System.Environment.NewLine &amp; "projects is an array of objects with id, name, repoUrl, stars as a number, language, techStack as an array of strings, starSummary, isSelected as a boolean." &amp; System.Environment.NewLine &amp; "skills is an array of objects with category and items which is an array of strings." &amp; System.Environment.NewLine &amp; "education is an array of objects with institution, degree, graduationYear, gpa." &amp; System.Environment.NewLine &amp; "Never invent employers, dates, degrees, or metrics that are absent from the supplied data."]</InArgument>
        </Assign.Value>
      </Assign>

      <!-- 4. Build user prompt carrying the scraped profile data -->
      <Assign DisplayName="Build Gemini user prompt" sap2010:WorkflowViewState.IdRef="Assign_8">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[strPromptText]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">["TARGET JOB ROLE: " &amp; in_TargetJobRole &amp; System.Environment.NewLine &amp; "PERSONAL INFO JSON: " &amp; in_PersonalInfoJson &amp; System.Environment.NewLine &amp; "LINKEDIN DATA JSON: " &amp; in_LinkedInDataJson &amp; System.Environment.NewLine &amp; "GITHUB DATA JSON: " &amp; in_GitHubDataJson &amp; System.Environment.NewLine &amp; "Produce the resume JSON now."]</InArgument>
        </Assign.Value>
      </Assign>

      <!-- 5. Escape both prompts so they are safe to embed inside the JSON request body -->
      <Assign DisplayName="Escape system prompt for JSON" sap2010:WorkflowViewState.IdRef="Assign_9">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[strSystemEscaped]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[strSystemPrompt.Replace("\", "\\").Replace(ChrW(34).ToString(), "\" &amp; ChrW(34).ToString()).Replace(ChrW(13).ToString(), "\r").Replace(ChrW(10).ToString(), "\n")]</InArgument>
        </Assign.Value>
      </Assign>
      <Assign DisplayName="Escape user prompt for JSON" sap2010:WorkflowViewState.IdRef="Assign_10">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[strPromptEscaped]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[strPromptText.Replace("\", "\\").Replace(ChrW(34).ToString(), "\" &amp; ChrW(34).ToString()).Replace(ChrW(13).ToString(), "\r").Replace(ChrW(10).ToString(), "\n")]</InArgument>
        </Assign.Value>
      </Assign>

      <!-- 6. Assemble the Gemini generateContent request body -->
      <Assign DisplayName="Build Gemini request body" sap2010:WorkflowViewState.IdRef="Assign_11">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[strRequestBody]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">["{""systemInstruction"":{""parts"":[{""text"":""" &amp; strSystemEscaped &amp; """}]},""contents"":[{""parts"":[{""text"":""" &amp; strPromptEscaped &amp; """}]}],""generationConfig"":{""responseMimeType"":""application/json"",""temperature"":0.4}}"]</InArgument>
        </Assign.Value>
      </Assign>
      <Assign DisplayName="Build Gemini endpoint URL" sap2010:WorkflowViewState.IdRef="Assign_12">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[strApiUrl]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">["https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=" &amp; strApiKey]</InArgument>
        </Assign.Value>
      </Assign>

      <!-- 7. Call Gemini only when a usable API key is present -->
      <If Condition="[String.IsNullOrWhiteSpace(strApiKey)]" sap2010:Annotation.AnnotationText="[PERCABANGAN LOGIKA] Memeriksa keberadaan API key Gemini. Jika kosong, lewati panggilan network dan tandai AI sebagai skipped untuk memicu fallback lokal." DisplayName="Skip AI call when API key is missing" sap2010:WorkflowViewState.IdRef="If_2">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <If.Then>
          <Sequence DisplayName="No API key fallback" sap2010:WorkflowViewState.IdRef="Sequence_3">
            <Assign DisplayName="Mark AI as skipped" sap2010:WorkflowViewState.IdRef="Assign_13">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Boolean">[boolAiSuccess]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Boolean">[False]</InArgument>
