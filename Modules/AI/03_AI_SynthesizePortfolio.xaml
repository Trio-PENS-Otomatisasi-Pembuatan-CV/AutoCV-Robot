        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[String.Empty]</InArgument>
        </Assign.Value>
      </Assign>
      <Assign DisplayName="Initialize API key" sap2010:WorkflowViewState.IdRef="Assign_3">
        <Assign.To>
