                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">["Gemini call failed: " &amp; exception.Message]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <ui:LogMessage DisplayName="Log Gemini exception" sap2010:WorkflowViewState.IdRef="LogMessage_5" Level="Warn" Message="[&quot;[03_AI] &quot; &amp; strErrorDetail]" />
                    </Sequence>
                  </ActivityAction>
                </Catch>
              </TryCatch.Catches>
            </TryCatch>
          </Sequence>
        </If.Else>
      </If>

      <!-- 8. Publish outputs: Gemini result when AI succeeded, otherwise empty + error -->
      <If Condition="[boolAiSuccess]" sap2010:Annotation.AnnotationText="[PERCABANGAN LOGIKA] Pemilihan Output: Jika boolAiSuccess=True, publikasikan JSON hasil Gemini. Jika False, muat Data/Mocks/CuratedResumeMock.json sebagai fallback deterministik agar alur tetap berjalan lancar." DisplayName="Publish AI result or report failure" sap2010:WorkflowViewState.IdRef="If_4">
        <sap:WorkflowViewStateService.ViewState>
          <scg:Dictionary x:TypeArguments="x:String, x:Object">
            <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
          </scg:Dictionary>
        </sap:WorkflowViewStateService.ViewState>
        <If.Then>
          <Sequence DisplayName="Publish Gemini result" sap2010:WorkflowViewState.IdRef="Sequence_9">
            <Assign DisplayName="Expose synthesized resume JSON" sap2010:WorkflowViewState.IdRef="Assign_23">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_SynthesizedResumeJson]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[strExtractedJson]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Set AI status to Gemini" sap2010:WorkflowViewState.IdRef="Assign_24">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_AIStatus]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">["GEMINI_SYNTHESIS"]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Clear AI warning" sap2010:WorkflowViewState.IdRef="Assign_25">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_AIWarning]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[String.Empty]</InArgument>
              </Assign.Value>
            </Assign>
          </Sequence>
        </If.Then>
        <If.Else>
          <Sequence DisplayName="Report AI failure" sap2010:WorkflowViewState.IdRef="Sequence_10">
            <Assign DisplayName="Set output to fallback mock on AI failure" sap2010:WorkflowViewState.IdRef="Assign_26">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_SynthesizedResumeJson]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[If(System.IO.File.Exists("Data\Mocks\CuratedResumeMock.json"), System.IO.File.ReadAllText("Data\Mocks\CuratedResumeMock.json"), "{}")]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Set AI status to fallback mock" sap2010:WorkflowViewState.IdRef="Assign_27">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_AIStatus]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">["SUCCESS_MOCK_FALLBACK"]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Expose error detail as warning" sap2010:WorkflowViewState.IdRef="Assign_28">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[out_AIWarning]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[If(String.IsNullOrWhiteSpace(strErrorDetail), "AI synthesis failed with no detail.", strErrorDetail)]</InArgument>
              </Assign.Value>
            </Assign>
            <ui:LogMessage DisplayName="Log AI failure outcome" sap2010:WorkflowViewState.IdRef="LogMessage_7" Level="Warn" Message="[&quot;[03_AI] AI synthesis fell back to mock. Detail: &quot; &amp; out_AIWarning]" />
          </Sequence>
        </If.Else>
      </If>
    </Sequence>
    <ui:LogMessage DisplayName="Log AI synthesis outcome" sap2010:WorkflowViewState.IdRef="LogMessage_6" Level="Info" Message="[&quot;[03_AI] Synthesis finished with status &quot; &amp; out_AIStatus &amp; &quot;. Output length: &quot; &amp; out_SynthesizedResumeJson.Length]" />
  </Sequence>
</Activity>
