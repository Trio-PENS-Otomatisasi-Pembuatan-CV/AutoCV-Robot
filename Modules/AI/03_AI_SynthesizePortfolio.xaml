                          </Assign.Value>
                        </Assign>
                        <ui:LogMessage DisplayName="Log Gemini success" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[&quot;[03_AI] Gemini synthesis succeeded. Resume JSON length: &quot; &amp; strExtractedJson.Length]" />
                      </Sequence>
                    </If.Then>
                    <If.Else>
                      <Sequence DisplayName="Handle non-200 response" sap2010:WorkflowViewState.IdRef="Sequence_7">
