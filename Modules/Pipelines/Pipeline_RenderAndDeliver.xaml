        <InArgument x:TypeArguments="x:String" x:Key="in_CandidateName">["Candidate"]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SmtpHost" />
        <InArgument x:TypeArguments="x:Int32" x:Key="in_SmtpPort">[587]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SmtpUser" />
        <InArgument x:TypeArguments="x:String" x:Key="in_SmtpPassword" />
        <InArgument x:TypeArguments="x:Boolean" x:Key="in_SimulationMode">[True]</InArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_MailSent" />
        <OutArgument x:TypeArguments="x:String" x:Key="out_DeliveryStatus" />
      </ui:InvokeWorkflowFile.Arguments>
