  <Sequence sap2010:Annotation.AnnotationText="[SINGLE RESPONSIBILITY] Pipeline Orkestrasi Fase 2 (Rendering &amp; Delivery). Bertanggung jawab mengompilasi dokumen resmi ATS (DOCX &amp; PDF) dari payload kurasi manusia (#HumanInTheLead), mendistribusikan email lampiran ke kandidat, dan mengirimkan notifikasi Webhook /complete beserta Base64 PDF ke Web Portal.&#xA;&#xA;[KONTRAK ARGUMEN]&#xA;- in_JobId (String): ID unik pekerjaan dari Web Portal (contoh: &quot;job-123&quot;).&#xA;- in_ApprovedResumePayload (String): Payload JSON resume hasil persetujuan/kurasi manusia. Wajib terisi untuk memicu Fase 2.&#xA;- in_RecipientEmail (String): Alamat email tujuan pengiriman berkas resume.&#xA;- in_WebhookBaseUrl (String): Base URL backend untuk pelaporan status final.&#xA;- out_JobStatus (String): Status akhir eksekusi (&quot;COMPLETED&quot;).&#xA;- out_OutputPdfPath (String): Path absolut file PDF resume yang berhasil digenerate." DisplayName="Pipeline: Render and Deliver" sap:VirtualizedContainerService.HintSize="576,1700" sap2010:WorkflowViewState.IdRef="Sequence_RenderAndDeliver">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="strNormalizedEmail" />
      <Variable x:TypeArguments="x:String" Name="strOutputPdfPath" />
      <Variable x:TypeArguments="x:Int32" Name="intWebhookStatus" />
      <Variable x:TypeArguments="x:String" Name="strWebhookResp" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>

    <!-- 1. Normalization & Context Setup -->
    <Assign DisplayName="Default Recipient Email if empty" sap:VirtualizedContainerService.HintSize="542,113.6" sap2010:WorkflowViewState.IdRef="Assign_DeliverEmail">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[strNormalizedEmail]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(String.IsNullOrWhiteSpace(in_RecipientEmail), "farid@example.com", in_RecipientEmail)]</InArgument>
      </Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log starting PDF generation" sap:VirtualizedContainerService.HintSize="542,141" sap2010:WorkflowViewState.IdRef="LogMessage_StartPdf" Level="Info" Message="[&quot;[RenderAndDeliver] Generating ATS-Compliant PDF document via 04_Document_GeneratePdf.&quot;]" />

    <!-- 2. Invoke 04_Document_GeneratePdf -->
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="[SUB-WORKFLOW] Mengompilasi payload JSON menjadi dokumen DOCX (Native OpenXML) dan mengekspornya ke PDF ATS via headless browser Chromium." DisplayName="Invoke 04_Document_GeneratePdf workflow" sap:VirtualizedContainerService.HintSize="542,113.6" sap2010:WorkflowViewState.IdRef="Invoke_DocGen" UnSafe="False" WorkflowFileName="Modules\Document\04_Document_GeneratePdf.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_CuratedResumeJson">[in_ApprovedResumePayload]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_TemplatePath">["Data\Templates\ATS_Resume_Template.docx"]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_OutputDir">["Data\Outputs"]</InArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_GeneratedPdfPath">[strOutputPdfPath]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_GeneratedDocxPath" />
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>

    <Assign DisplayName="Expose PDF output path" sap:VirtualizedContainerService.HintSize="542,113.6" sap2010:WorkflowViewState.IdRef="Assign_OutPdf">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_OutputPdfPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[strOutputPdfPath]</InArgument>
      </Assign.Value>
    </Assign>

    <!-- 3. Invoke 05_Notification_SendMail -->
    <ui:LogMessage DisplayName="Publish email dispatch" sap:VirtualizedContainerService.HintSize="542,141" sap2010:WorkflowViewState.IdRef="LogMessage_MailDispatch" Level="Info" Message="[&quot;[RenderAndDeliver] Delivering final ATS Resume PDF to &quot; &amp; strNormalizedEmail]" />
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="[SUB-WORKFLOW] Mengirimkan dokumen PDF resume sebagai lampiran email ke alamat kandidat (mendukung mode SMTP asli atau SIMULATION)." DisplayName="Invoke 05_Notification_SendMail workflow" sap:VirtualizedContainerService.HintSize="542,113.6" sap2010:WorkflowViewState.IdRef="Invoke_SendMail" UnSafe="False" WorkflowFileName="Modules\Notification\05_Notification_SendMail.xaml">
