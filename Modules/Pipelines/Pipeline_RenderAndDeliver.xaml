            <OutArgument x:TypeArguments="x:String" x:Key="out_ResponseContent">[strWebhookResp]</OutArgument>
          </ui:InvokeWorkflowFile.Arguments>
        </ui:InvokeWorkflowFile>
      </If.Then>
    </If>

    <!-- 5. Mark Completed -->
    <Assign DisplayName="Set completed status" sap:VirtualizedContainerService.HintSize="542,113.6" sap2010:WorkflowViewState.IdRef="Assign_DeliverCompleted">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_JobStatus]</OutArgument>
