# ====================================================================
# UiPath Studio - Git Ignore Configuration
# Project: AutoCV_Robot (Target: Windows, .NET 10)
# ====================================================================

# --------------------------------------------------------------------
# 1. UiPath Caches & Auto-Generated Files (Wajib di-ignore)
# --------------------------------------------------------------------
# Berisi cache build lokal, database SQLite dependency, nuget cache, dan JIT artifacts.
.local/
**/.local/

# Cache Test Manager Hub
.tmh/
**/.tmh/

# Cache template lokal
.templates/
**/.templates/

# Cache UiPath Data Service entities (uncomment jika entities dikelola via cloud)
.entities/
**/.entities/

# --------------------------------------------------------------------
# 2. Backup & Temporary Files
# --------------------------------------------------------------------
# File backup otomatis UiPath saat crash/recovery
project.backup/
**/*.backup
**/*.tmp
*.tmp
*~
~*
~$*

# --------------------------------------------------------------------
# 3. Execution Logs & Test Outputs
# --------------------------------------------------------------------
# Log eksekusi robot
*.log
**/*.log

# Screenshot exception / error saat runtime
**/Exceptions_Screenshots/
# Jika menggunakan REFramework/Custom screenshot runtime:
# .screenshots/

# Direktori output hasil eksekusi uji coba (CV PDF, Excel export, dll.)
Data/Output/*
Data/Outputs/*
!Data/Output/.gitkeep
!Data/Outputs/.gitkeep

# Direktori temporary processing
Data/Temp/*
!Data/Temp/.gitkeep

# --------------------------------------------------------------------
# 4. Sensitive Data & Local Configuration
# --------------------------------------------------------------------
# File config lokal yang berisi kredensial atau endpoint lokal
Data/Config_Local.xlsx
Data/*_Local.xlsx
*.env
*.env.*
!*.env.example
credentials.json
secrets.json

# --------------------------------------------------------------------
# 5. NuGet Packages & Publish Artifacts
# --------------------------------------------------------------------
# Paket nupkg hasil publish lokal
*.nupkg
*.snupkg
pkg/

# --------------------------------------------------------------------
# 6. Microsoft Office Lock Files (Excel / Word)
# --------------------------------------------------------------------
# File lock saat file Excel/Word sedang dibuka di Studio atau Excel
~$*.xlsx
~$*.xlsm
~$*.xls
~$*.docx
~$*.pptx
~$*.csv

# --------------------------------------------------------------------
# 7. IDE & Editor Artifacts
# --------------------------------------------------------------------
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.suo
*.user
*.userosv
*.sln.docstates
.idea/

# --------------------------------------------------------------------
# 8. OS Generated Files
# --------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --------------------------------------------------------------------
# Catatan Arsitektur Proyek:
# - Main.xaml & *.xaml : Kode alur utama (Wajib di-commit)
# - project.json & project.uiproj : Manifest dependensi dan target framework (Wajib di-commit)
# - .objects/ : Source Object Repository (UI Descriptors) - Jangan di-ignore agar elemen UI tidak hilang.
# - .settings/ : Konfigurasi profile build Debug & Release - Disimpan untuk konsistensi tim.
# --------------------------------------------------------------------
